@startuml
!include https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Context.puml

title Диаграмма контекста для монолитного приложения "Тёплый дом"

Person(user, "Пользователь", "Владелец дома, использует систему для управления отоплением.")
Person_Ext(инженер, "Инженер по подключению", "Специалист, подключающий оборудование к системе.")
System_Boundary(Монолит, "Монолитное приложение 'Тёплый дом'") {
    System(УправлениеОтоплением, "Управление отоплением", "Обрабатывает команды пользователя для управления отоплением дома.")
    System(МониторингТемпературы, "Мониторинг температуры", "Получает данные о температуре от датчиков и передает их пользователю.")
}

System_Ext(Датчики, "Датчики температуры", "Передают данные о текущей температуре в доме.")
System_Ext(Реле, "Реле отопления", "Управляют включением/выключением отопления в доме.")
System_Ext(СервисПодключения, "Сервис подключения", "Требует участия специалистов для подключения оборудования.")

Rel(user, УправлениеОтоплением, "Отправляет команды на управление отоплением")
Rel(user, МониторингТемпературы, "Просматривает данные о текущей температуре")
Rel(УправлениеОтоплением, Реле, "Отправляет команды для включения/выключения отопления")
Rel(МониторингТемпературы, Датчики, "Получает данные о температуре")
Rel(инженер, СервисПодключения, "Выполняет подключение оборудования")
Rel(СервисПодключения, МониторингТемпературы, "Регистрирует датчики температуры в системе")
Rel(СервисПодключения, УправлениеОтоплением, "Регистрирует реле отопления в системе")

@enduml
